# .venv may be a symlink to .venv.nosync (keeps iCloud Drive from flagging
# virtualenv files hidden, which makes Python skip .pth files).
.venv
.venv.nosync/
.pytest_cache/
.ruff_cache/
.mypy_cache/
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/
.coverage
htmlcov/
.DS_Store
.superpowers/
# Impeccable design work: keep the direction contract (.impeccable/surfaces/)
# and the design sidecar (.impeccable/design.json); the rest is local evidence.
.impeccable/build/
.impeccable/mocks/
.impeccable/questions/
.impeccable/review/
.impeccable/archive/
.impeccable/tmp/
.impeccable/config.local.json
