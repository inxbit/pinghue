# .venv may be a symlink to .venv.nosync (keeps iCloud Drive from flagging
# virtualenv files hidden, which makes Python skip .pth files).
.venv
.venv.nosync/
.pytest_cache/
.ruff_cache/
.mypy_cache/
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/
.coverage
htmlcov/
.DS_Store
.superpowers/

# Impeccable design workflow scratch (mocks, build state, review captures).
# The direction contract (surfaces/) and the design sidecar (design.json) are kept.
.impeccable/build/
.impeccable/mocks/
.impeccable/questions/
.impeccable/review/
.impeccable/tmp/
