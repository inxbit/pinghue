{
  "name": "protect main",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/main"],
      "exclude": []
    }
  },
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "required_signatures" },
    { "type": "required_linear_history" },
    {
      "type": "pull_request",
      "parameters": {
        "allowed_merge_methods": ["squash", "rebase"],
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "do_not_enforce_on_create": true,
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          { "context": "ubuntu-latest / Python 3.10", "integration_id": 15368 },
          { "context": "ubuntu-latest / Python 3.11", "integration_id": 15368 },
          { "context": "ubuntu-latest / Python 3.12", "integration_id": 15368 },
          { "context": "ubuntu-latest / Python 3.13", "integration_id": 15368 },
          { "context": "ubuntu-latest / Python 3.14", "integration_id": 15368 },
          { "context": "macos-latest / Python 3.10", "integration_id": 15368 },
          { "context": "macos-latest / Python 3.11", "integration_id": 15368 },
          { "context": "macos-latest / Python 3.12", "integration_id": 15368 },
          { "context": "macos-latest / Python 3.13", "integration_id": 15368 },
          { "context": "macos-latest / Python 3.14", "integration_id": 15368 },
          { "context": "Reproducible distributions", "integration_id": 15368 },
          { "context": "Dependency audit / Python 3.10", "integration_id": 15368 },
          { "context": "Dependency audit / Python 3.13", "integration_id": 15368 }
        ]
      }
    }
  ]
}
