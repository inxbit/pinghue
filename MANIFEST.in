include README.md
include LICENSE
include CHANGELOG.md
include SECURITY.md
include CODE_OF_CONDUCT.md
include pinghue-threat-model.md
include security-best-practices-report.md
prune .github
prune packaging
include scripts/pinghue
recursive-include schemas *.json
recursive-include examples *.json
recursive-include docs *.svg *.gif *.png
exclude CONTRIBUTING.md
recursive-include tests *.py
exclude tests/test_repository_hardening.py
exclude tests/test_github_hardening_apply.py
exclude tests/test_normalize_sdist.py
